---
interface Props {
  title: string;
}
import Footer from "../components/FooterComponent/footer.astro";
import Header from "../components/HeaderComponent/header.astro";
import "@fontsource/roboto";
import MainComponent from "../components/MainComponent/MainComponent.astro";
const { title } = Astro.props;
import Proyects from "../components/ProyectsComponent/proyects.astro";
import "@fontsource-variable/cinzel";
import "@fontsource-variable/syne";
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portfolio de María Gargoles - Desarrolladora Full Stack freelance con experiencia en React, Node.js, MongoDB y más tecnologías"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="María Gargoles Lajarin" />
    <meta
      name="keywords"
      content="desarrolladora, full stack, freelance, React, Node.js, MongoDB, portfolio"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      (function () {
        const theme = localStorage.getItem("theme") || "light";
        document.documentElement.className = theme;
      })();
    </script>
    <script>
      // Inicializar mejoras de accesibilidad
      import { initializeAccessibility } from "../utils/accessibility.ts";
      document.addEventListener("DOMContentLoaded", () => {
        initializeAccessibility();
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main-content" role="main">
      <MainComponent />
      <Proyects />
    </main>
    <Footer />
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: var(--accent);
    color: white;
    padding: 8px;
    text-decoration: none;
    border-radius: 4px;
    z-index: 1000;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }

  html.light {
    --background-color: #ffffff;
    --text-color: #1a1a1a;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }

  html.light nav a:hover {
    background-color: rgb(179, 182, 183);
  }

  html.light nav a:focus {
    background-color: rgb(179, 182, 183);
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  html.light footer {
  }

  html.dark {
    --background-color: #1a1a1a;
    --text-color: #ffffff;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent-dark)),
      rgb(var(--accent)),
      black 60%
    );
  }

  html.dark nav a:hover {
    background-color: rgb(82, 82, 82);
  }

  html.dark nav a:focus {
    background-color: rgb(82, 82, 82);
    outline: 2px solid #66b3ff;
    outline-offset: 2px;
  }

  html.light header {
    box-shadow: 0em 0.18em 0.3em 0em rgba(0, 0, 0, 0.29);
  }
  html.dark header {
    box-shadow: 0em 0.18em 0.32em 0em rgba(255, 255, 255, 0.15);
  }
  header {
    font-family: "Roboto", sans-serif;
  }
  section > h2 {
    font-family: "Roboto", sans-serif;
  }
  body {
    background-color: var(--background-color);
    color: var(--text-color);
    font-family: var(--font-family);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  /* Mejorar contraste para elementos interactivos */
  button:focus,
  a:focus,
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  html.dark button:focus,
  html.dark a:focus,
  html.dark input:focus,
  html.dark textarea:focus,
  html.dark select:focus {
    outline: 2px solid #66b3ff;
    outline-offset: 2px;
  }

  /* Mejorar contraste de texto */
  .text-muted {
    color: #666666;
  }

  html.dark .text-muted {
    color: #cccccc;
  }
  html.light footer {
    box-shadow: 0em -0.31em 2.4em 0em rgba(0, 0, 0, 0.5);
  }
  html.dark footer {
    box-shadow: 0em -0.31em 1.4em 0em rgba(255, 255, 255, 0.15);
  }
</style>
