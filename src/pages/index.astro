---
interface Props {
  title: string;
}
import Footer from "../components/FooterComponent/footer.astro";
import Header from "../components/HeaderComponent/header.astro";
import "@fontsource/roboto";
import MainComponent from "../components/MainComponent/MainComponent.astro";
const { title } = Astro.props;
import Proyects from "../components/ProyectsComponent/proyects.astro";
import "@fontsource-variable/cinzel";
import "@fontsource-variable/syne";
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Portfolio de María Gargoles - Desarrolladora Full Stack freelance con experiencia en React, Node.js, MongoDB y más tecnologías"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="María Gargoles Lajarin" />
    <meta
      name="keywords"
      content="desarrolladora, full stack, freelance, React, Node.js, MongoDB, portfolio"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script>
      (function () {
        const theme = localStorage.getItem("theme") || "light";
        document.documentElement.className = theme;
      })();
    </script>
    <script>
      // Inicializar mejoras de accesibilidad
      import { initializeAccessibility } from "../utils/accessibility.ts";
      document.addEventListener("DOMContentLoaded", () => {
        initializeAccessibility();
      });
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <a href="#navigation" class="skip-link">Saltar a la navegación</a>
    <a href="#projects" class="skip-link">Saltar a los proyectos</a>
    <Header />
    <main
      id="main-content"
      role="main"
      aria-label="Contenido principal del portfolio"
    >
      <MainComponent />
      <section id="projects" aria-labelledby="projects-heading">
        <Proyects />
      </section>
    </main>
    <Footer />
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: var(--accent);
    color: white;
    padding: 8px;
    text-decoration: none;
    border-radius: 4px;
    z-index: 1000;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }

  html.light {
    --background-color: #ffffff;
    --text-color: #1a1a1a;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }

  html.light nav a:hover {
    background-color: rgb(179, 182, 183);
  }

  html.light nav a:focus {
    background-color: rgb(179, 182, 183);
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  html.light footer {
  }

  html.dark {
    --background-color: #1a1a1a;
    --text-color: #ffffff;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent-dark)),
      rgb(var(--accent)),
      black 60%
    );
  }

  html.dark nav a:hover {
    background-color: rgb(82, 82, 82);
  }

  html.dark nav a:focus {
    background-color: rgb(82, 82, 82);
    outline: 2px solid #66b3ff;
    outline-offset: 2px;
  }

  html.light header {
    box-shadow: 0em 0.18em 0.3em 0em rgba(0, 0, 0, 0.29);
  }
  html.dark header {
    box-shadow: 0em 0.18em 0.32em 0em rgba(255, 255, 255, 0.15);
  }
  header {
    font-family: "Roboto", sans-serif;
  }
  section > h2 {
    font-family: "Roboto", sans-serif;
  }
  body {
    background-color: var(--background-color);
    color: var(--text-color);
    font-family: var(--font-family);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  /* Mejorar contraste para elementos interactivos */
  button:focus,
  a:focus,
  input:focus,
  textarea:focus,
  select:focus {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  html.dark button:focus,
  html.dark a:focus,
  html.dark input:focus,
  html.dark textarea:focus,
  html.dark select:focus {
    outline: 2px solid #66b3ff;
    outline-offset: 2px;
  }

  /* Mejorar contraste de texto */
  .text-muted {
    color: #666666;
  }

  html.dark .text-muted {
    color: #cccccc;
  }
  html.light footer {
    box-shadow: 0em -0.31em 2.4em 0em rgba(0, 0, 0, 0.5);
  }
  html.dark footer {
    box-shadow: 0em -0.31em 1.4em 0em rgba(255, 255, 255, 0.15);
  }

  /* Mejorar accesibilidad de skip links */
  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: var(--accent);
    color: white;
    padding: 8px;
    text-decoration: none;
    border-radius: 4px;
    z-index: 1000;
    transition: top 0.3s;
    font-weight: bold;
  }

  .skip-link:focus {
    top: 6px;
  }

  /* Mejorar accesibilidad de landmarks */
  [role="main"] {
    outline: none;
  }

  [role="banner"] {
    outline: none;
  }

  [role="contentinfo"] {
    outline: none;
  }

  [role="navigation"] {
    outline: none;
  }

  [role="region"] {
    outline: none;
  }

  [role="article"] {
    outline: none;
  }

  /* Mejorar accesibilidad de elementos interactivos */
  button:focus-visible,
  a:focus-visible,
  input:focus-visible,
  textarea:focus-visible,
  select:focus-visible {
    outline: 2px solid #0066cc;
    outline-offset: 2px;
  }

  html.dark button:focus-visible,
  html.dark a:focus-visible,
  html.dark input:focus-visible,
  html.dark textarea:focus-visible,
  html.dark select:focus-visible {
    outline: 2px solid #66b3ff;
    outline-offset: 2px;
  }

  /* Mejorar contraste de texto */
  .text-muted {
    color: #666666;
  }

  html.dark .text-muted {
    color: #cccccc;
  }

  /* Mejorar accesibilidad de imágenes */
  img {
    max-width: 100%;
    height: auto;
  }

  /* Mejorar accesibilidad de enlaces */
  a {
    color: inherit;
    text-decoration: underline;
  }

  a:hover {
    text-decoration: none;
  }

  /* Mejorar accesibilidad de botones */
  button {
    cursor: pointer;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }

  /* Mejorar accesibilidad de formularios */
  input,
  textarea,
  select {
    font-size: 16px;
  }

  /* Mejorar accesibilidad de listas */
  ul,
  ol {
    padding-left: 1.5em;
  }

  li {
    margin-bottom: 0.5em;
  }

  /* Mejorar accesibilidad de tablas */
  table {
    border-collapse: collapse;
    width: 100%;
  }

  th,
  td {
    border: 1px solid #ddd;
    padding: 8px;
    text-align: left;
  }

  th {
    background-color: #f2f2f2;
    font-weight: bold;
  }

  html.dark th {
    background-color: #333;
  }

  /* Mejorar accesibilidad de videos */
  video {
    max-width: 100%;
    height: auto;
  }

  /* Mejorar accesibilidad de audio */
  audio {
    width: 100%;
  }
</style>
