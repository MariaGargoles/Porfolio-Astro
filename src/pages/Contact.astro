---
interface Props {
  title: string;
}
import Footer from "../components/FooterComponent/footer.astro";
import Header from "../components/HeaderComponent/header.astro";
import "@fontsource/roboto";
const { title } = Astro.props;
import "@fontsource-variable/cinzel";
import "@fontsource-variable/syne";
import ContactMainComponent from "@components/ContactComponent/ContactMainComponent.astro";
import { FaExpeditedssl } from "react-icons/fa";
---

<!doctype html>
<html lang="es" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Contacta con María Gargoles - Desarrolladora Full Stack freelance. Envíame un mensaje para proyectos de desarrollo web"
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="María Gargoles Lajarin" />
    <meta
      name="keywords"
      content="contacto, desarrolladora, full stack, freelance, React, Node.js, MongoDB, portfolio"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={`${import.meta.env.BASE_URL}favicon.svg`}
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script src="https://cdn.jsdelivr.net/npm/emailjs-com@3/dist/email.min.js"
    ></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
      (function () {
        const theme = localStorage.getItem("theme") || "light";
        document.documentElement.className = theme;
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>
    <Header />
    <main id="main-content" role="main">
      <ContactMainComponent />
    </main>
    <Footer class="fixed-footer" />
    <slot />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 6px;
    background: var(--accent);
    color: white;
    padding: 8px;
    text-decoration: none;
    border-radius: 4px;
    z-index: 1000;
    transition: top 0.3s;
  }

  .skip-link:focus {
    top: 6px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  :root {
    --accent: 136, 58, 234;
    --accent-light: 224, 204, 250;
    --accent-dark: 49, 10, 101;
  }

  html.light {
    --background-color: #ecf0f1;
    --text-color: #1c2833;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent)),
      rgb(var(--accent-light)) 30%,
      white 60%
    );
  }

  html.light nav a:hover {
    background-color: rgb(179, 182, 183);
  }

  html.light footer {
  }

  html.dark {
    --background-color: #212121;
    --text-color: #f7f9f9;
    --accent-gradient: linear-gradient(
      45deg,
      rgb(var(--accent-dark)),
      rgb(var(--accent)),
      black 60%
    );
  }

  html.dark nav a:hover {
    background-color: rgb(82, 82, 82);
  }

  html.light header {
    box-shadow: 0em 0.18em 0.3em 0em rgba(0, 0, 0, 0.29);
  }
  header {
    font-family: "Roboto", sans-serif;
  }
  section > h2 {
    font-family: "Roboto", sans-serif;
  }
  body {
    background-color: var(--background-color);
    color: var(--text-color);
    font-family: var(--font-family);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  html.light input {
    background-color: white;
    color: black;
  }

  html.light textarea {
    background-color: white;
    color: black;
  }
  html.light footer {
    box-shadow: 0em -0.31em 2.4em 0em rgba(0, 0, 0, 0.5);
  }
  .fixed-footer {
    position: fixed;
    bottom: 0;
    left: 0;
    width: 100%;
    z-index: 10;
    box-shadow: 0em -0.31em 2.4em 0em rgba(0, 0, 0, 0.5);
  }
</style>
