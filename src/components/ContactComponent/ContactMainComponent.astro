---
const withBase = (p: string) =>
  `${import.meta.env.BASE_URL.replace(/\/+$/, "/")}${p.replace(/^\/+/, "")}`;
---

<script>
  import { EmailJs } from "../../utils/EmailJs";
  import { initializeFormValidation } from "../../utils/form-validation";

  EmailJs();

  document.addEventListener("DOMContentLoaded", () => {
    initializeFormValidation();
  });
</script>

<main class="p-12 mt-16" role="main">
  <section
    class="flex flex-col items-center border rounded-lg p-12 w-full max-w-3xl mx-auto shadow-lg"
    aria-labelledby="contact-heading"
  >
    <article class="flex flex-col items-center text-center">
      <h1 id="contact-heading" class="pb-3 font-cinzel text-2xl font-bold">
        Contáctame
      </h1>
      <p class="font-roboto p-10 text-sm md:text-base leading-relaxed">
        Si quieres ponerte en contacto conmigo, por favor completa el siguiente
        formulario. Estaré encantada de responderte lo antes posible. 😊
      </p>
    </article>

    <!-- Formulario -->
    <form
      id="contact-form"
      class="flex flex-col w-full gap-6"
      role="form"
      aria-label="Formulario de contacto"
      novalidate
    >
      <div class="flex flex-col">
        <label for="name" class="font-roboto text-sm font-bold">
          Nombre <span class="text-red-500" aria-label="campo obligatorio"
            >*</span
          >
        </label>
        <input
          type="text"
          id="name"
          name="from_name"
          required
          aria-required="true"
          aria-describedby="name-error"
          class="border rounded-lg p-2 mt-1 text-base dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent min-h-[44px]"
          placeholder="Tu nombre"
          autocomplete="name"
        />
        <div
          id="name-error"
          class="text-red-500 text-xs mt-1"
          role="alert"
          aria-live="polite"
        >
        </div>
      </div>

      <div class="flex flex-col">
        <label for="email" class="font-roboto text-sm font-bold">
          Correo Electrónico <span
            class="text-red-500"
            aria-label="campo obligatorio">*</span
          >
        </label>
        <input
          type="email"
          id="email"
          name="user_email"
          required
          aria-required="true"
          aria-describedby="email-error"
          class="border rounded-lg p-2 mt-1 text-base dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent min-h-[44px]"
          placeholder="Tu correo electrónico"
          autocomplete="email"
        />
        <div
          id="email-error"
          class="text-red-500 text-xs mt-1"
          role="alert"
          aria-live="polite"
        >
        </div>
      </div>

      <div class="flex flex-col">
        <label for="message" class="font-roboto text-sm font-bold">
          Mensaje <span class="text-red-500" aria-label="campo obligatorio"
            >*</span
          >
        </label>
        <textarea
          id="message"
          name="message"
          required
          aria-required="true"
          aria-describedby="message-error"
          rows="5"
          class="border rounded-lg p-2 mt-1 text-base dark:bg-gray-800 dark:border-gray-600 dark:text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent min-h-[44px]"
          placeholder="Escribe tu mensaje aquí..."></textarea>
        <div
          id="message-error"
          class="text-red-500 text-xs mt-1"
          role="alert"
          aria-live="polite"
        >
        </div>
      </div>

      <button
        type="submit"
        class="px-6 py-2 rounded-md font-roboto text-sm font-bold bg-blue-500 text-white hover:bg-blue-600 transition duration-200 dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
        aria-describedby="submit-status"
      >
        <span class="submit-text">Enviar</span>
        <span class="loading-text sr-only">Enviando mensaje...</span>
      </button>

      <div
        id="submit-status"
        class="text-center"
        role="status"
        aria-live="polite"
      >
      </div>
    </form>
  </section>
  <div class="flex justify-center mt-8 py-3">
    <a
      href={withBase("")}
      class="px-6 py-2 rounded-md font-roboto text-sm font-bold
           bg-blue-500 text-white hover:bg-blue-600
           transition duration-200
           dark:bg-gray-700 dark:text-white dark:hover:bg-gray-600
           inline-block focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
      aria-label="Volver a la página principal"
    >
      Volver al Inicio
    </a>
  </div>
</main>
